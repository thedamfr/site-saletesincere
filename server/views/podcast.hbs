                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <img src="/images/youtube-logo.svg" alt="" class="w-10 h-10 flex-shrink-0">
                            <div class="text-left">
                                <div class="flex flex-wrap items-center gap-2 font-semibold text-black">
                                    <span>YouTube</span>
                                    {{#if episodeVideoAvailability.youtubeBadgeText}}
