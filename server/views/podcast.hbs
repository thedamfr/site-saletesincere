{{#*inline "expandableDescription"}}
    {{#if paragraphs.length}}
        {{#if expandable}}
        <details class="podcast-description">
            <summary>
                <span class="podcast-description-preview">{{preview}}…</span>
                <span class="podcast-description-toggle">
                    <span class="podcast-description-more">Voir plus</span>
                    <span class="podcast-description-less">Voir moins</span>
                </span>
            </summary>
            <div class="podcast-description-full">
                {{#each paragraphs}}<p>{{this}}</p>{{/each}}
            </div>
        </details>
        {{else}}
        <div class="podcast-description">
            {{#each paragraphs}}<p>{{this}}</p>{{/each}}
        </div>
        {{/if}}
    {{/if}}
{{/inline}}
