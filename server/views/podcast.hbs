<body class="landing-page podcast-page">
    <a class="landing-skip-link" href="#contenu">Aller au contenu</a>
    <header class="landing-header landing-shell">
        <a class="landing-logo" href="/" aria-label="Accueil Saleté Sincère">
            <img src="/images/logo-salete-sincere-horizontal.png" width="744" height="213" alt="Saleté Sincère">
        </a>
        <nav class="landing-navigation" aria-label="Navigation principale">
            <a href="/podcast" aria-current="page">Podcast</a>
            <a href="/#contact">Contact</a>
        </nav>
    </header>
    <main id="contenu" class="landing-shell podcast-main">
        {{#unless episodeData}}
        <section class="podcast-hero" aria-labelledby="podcast-title">
            <img class="podcast-cover" src="/images/charbon-wafer-cover.png" alt="Jaquette illustrée Charbon &amp; Wafer" width="1400" height="1400" fetchpriority="high">
            <div>
                <p class="podcast-eyebrow">Le podcast de Saleté Sincère</p>
                <h1 id="podcast-title">Charbon<br>&amp; Wafer</h1>
                <div class="podcast-intro">{{> expandableDescription podcastDescription}}</div>
                {{#if latestEpisode}}
                <a href="{{latestEpisode.url}}" class="landing-button landing-podcast-button"><span aria-hidden="true">▶</span> Écouter le dernier épisode</a>
                {{else}}
                <a href="#plateformes" class="landing-button landing-podcast-button">{{#if episodeData}}Écouter cet épisode{{else}}Écouter le podcast{{/if}} <span aria-hidden="true">↗</span></a>
                {{/if}}
            </div>
      {{#if landingEpisodes}}
        <div class="landing-episode-list" aria-label="Derniers épisodes">
          {{#each landingEpisodes}}
            <a class="landing-episode" href="{{url}}">
              <span class="landing-episode-play" aria-hidden="true">▶</span>
              <span class="landing-episode-copy">
                {{#if format}}<span class="landing-episode-format">{{format}}</span>{{/if}}
                <span class="landing-episode-title">{{title}}</span>
              </span>
              {{#if duration}}<span class="landing-episode-duration">{{duration}}</span>{{/if}}
            </a>
          {{/each}}

        </div>
      {{/if}}
        </section>
        {{else}}
        <a class="podcast-back" href="/podcast">← Tous les épisodes du podcast</a>
        {{/unless}}
        <div class="podcast-content">
            {{#if popularEpisode}}
            <article class="podcast-feature">
                {{#if popularEpisode.episode.image}}
                <img src="{{popularEpisode.episode.image}}" alt="Jaquette de l'épisode {{popularEpisode.episode.title}}" width="662" height="662" fetchpriority="high" class="podcast-feature-image">
                {{/if}}
