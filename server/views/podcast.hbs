                    <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-yellow-400">{{popularEpisode.label}}</p>
                    <p class="mb-2 text-sm uppercase text-[#ffc330]">Saison {{popularEpisode.episode.season}} • Épisode {{popularEpisode.episode.episode}}</p>
                    <h2 class="mb-3 text-2xl font-bold text-white">{{popularEpisode.episode.title}}</h2>
                    {{> expandableDescription popularEpisode.description}}
                    <div class="mb-5 flex flex-wrap gap-4 text-sm text-gray-400">
                        <span>⏱️ {{popularEpisode.episode.duration}}</span>
                        <span>{{popularEpisode.displayText}}</span>
                    </div>
                    <a href="/podcast/{{popularEpisode.episode.season}}/{{popularEpisode.episode.episode}}" class="landing-button landing-podcast-button">
                        Découvrir cet épisode
                    </a>
                </div>
            </article>
            {{/if}}
            
            {{#if episodeData}}
            <!-- Episode Highlight -->
            <div class="podcast-episode">
                {{#if episodeData.image}}
                <img src="{{episodeData.image}}" alt="Jaquette de l'épisode {{episodeData.title}}" width="662" height="662" fetchpriority="high" class="podcast-episode-cover">
                {{/if}}
                <div class="podcast-episode-copy">
                <div class="text-[#ffc330] text-sm uppercase mb-2">
                    Saison {{episodeData.season}} • Épisode {{episodeData.episode}}
                </div>
                <h1 class="text-2xl font-bold text-white mb-4">{{episodeData.title}}</h1>

                
                {{!-- OP3 Stats Badge (ADR-0015) --}}
                {{#if episodeStats}}
                {{#if episodeStats.displayText}}
                <details class="mb-4 text-sm text-[#ffc330]">
                    <summary class="flex list-none cursor-pointer items-center gap-2 rounded focus:outline-none focus:ring-2 focus:ring-purple-300 [&::-webkit-details-marker]:hidden" aria-label="Comprendre la mesure OP3">
                        <svg class="h-4 w-4 shrink-0 text-[#ffc330]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                            <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
                            <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
                        </svg>
                        <span class="font-medium">{{episodeStats.displayText}}</span>
                        <svg class="h-4 w-4 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                        </svg>
                    </summary>
                    <p class="mt-3 rounded-lg border border-[#55575a] bg-gray-800 p-3 text-xs text-gray-200">
                        OP3 mesure les téléchargements du fichier audio. Un téléchargement peut être automatique et ne garantit pas une écoute complète. Données mises à jour quotidiennement.
                    </p>
                </details>
                {{/if}}
                {{/if}}
                
                {{#if episodeData.audioUrl}}
                <!-- Waveform Audio Player -->
                <div class="mb-4 bg-black/30 rounded-xl p-4 backdrop-blur-sm">
                    <div class="flex items-center justify-between mb-3">
                        <div class="text-[#ffc330] text-xs font-medium">🎧 Pré-écoute de l'épisode</div>
                        <div class="text-[#ffc330] text-xs" id="time-{{episodeData.season}}-{{episodeData.episode}}">0:00 / {{episodeData.duration}}</div>
                    </div>
                    
                    <!-- Waveform container avec placeholder -->
                    <div class="relative mb-3 h-16">
                        <div id="waveform-{{episodeData.season}}-{{episodeData.episode}}" class="absolute inset-0 opacity-0 transition-opacity duration-500"></div>
                        <div id="waveform-loader-{{episodeData.season}}-{{episodeData.episode}}" 
                             class="absolute inset-0 flex items-center justify-center bg-white/5 rounded-lg">
                            <div class="flex gap-1.5 items-end">
                                <div class="w-1 h-8 bg-[#ffc330]/50 rounded-full animate-pulse" style="animation-delay: 0ms; animation-duration: 1s"></div>
                                <div class="w-1 h-12 bg-[#ffc330]/50 rounded-full animate-pulse" style="animation-delay: 150ms; animation-duration: 1.2s"></div>
                                <div class="w-1 h-6 bg-[#ffc330]/50 rounded-full animate-pulse" style="animation-delay: 300ms; animation-duration: 0.9s"></div>
                                <div class="w-1 h-10 bg-[#ffc330]/50 rounded-full animate-pulse" style="animation-delay: 450ms; animation-duration: 1.1s"></div>
                                <div class="w-1 h-7 bg-[#ffc330]/50 rounded-full animate-pulse" style="animation-delay: 600ms; animation-duration: 1s"></div>
                                <div class="w-1 h-9 bg-[#ffc330]/50 rounded-full animate-pulse" style="animation-delay: 750ms; animation-duration: 1.3s"></div>
                                <div class="w-1 h-5 bg-[#ffc330]/50 rounded-full animate-pulse" style="animation-delay: 900ms; animation-duration: 0.8s"></div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Play/Pause button -->
                    <div class="flex items-center justify-center">
                        <button id="playBtn-{{episodeData.season}}-{{episodeData.episode}}" type="button" aria-label="Lire l’épisode"
                                class="w-12 h-12 rounded-full bg-[#ffc330] hover:bg-[#ffcf59] flex items-center justify-center transition-all shadow-lg hover:shadow-xl hover:scale-105">
                            <svg id="playIcon-{{episodeData.season}}-{{episodeData.episode}}" class="w-5 h-5 text-black ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M8 5v14l11-7z"/>
                            </svg>
                            <svg id="pauseIcon-{{episodeData.season}}-{{episodeData.episode}}" class="w-5 h-5 text-black hidden" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/>
                            </svg>
                        </button>
                    </div>
                </div>
                
                <script type="module">
                    import WaveSurfer from 'https://cdn.jsdelivr.net/npm/wavesurfer.js@7/dist/wavesurfer.esm.js';
                    
                    (function() {
                        const episodeId = '{{episodeData.season}}-{{episodeData.episode}}';
                        const originalUrl = '{{{episodeData.audioUrl}}}'; // Triple braces pour éviter HTML encoding
                        const proxyUrl = `/api/audio/proxy?url=${encodeURIComponent(originalUrl)}`;
                        
                        console.log('🎵 Loading audio via proxy:', proxyUrl);
                        
                        const wavesurfer = WaveSurfer.create({
                            container: '#waveform-' + episodeId,
                            url: proxyUrl,
                            waveColor: '#F1F1F199',                    // Gris foncé (non joué)
                            progressColor: '#ffc330',                  // Purple solid (partie jouée)
                            cursorColor: '#ffc330',                    // Purple-400 pour le curseur
                            barWidth: 3,
                            barGap: 2,
                            height: 60,
                            normalize: true,
                            backend: 'WebAudio',
                            barRadius: 3,                              // Barres arrondies
                            dragToSeek: true                           // Click to seek
                        });
                        
                        const playBtn = document.getElementById('playBtn-' + episodeId);
                        const playIcon = document.getElementById('playIcon-' + episodeId);
                        const pauseIcon = document.getElementById('pauseIcon-' + episodeId);
                        const timeDisplay = document.getElementById('time-' + episodeId);
                        
                        // Play/Pause
                        playBtn.addEventListener('click', () => {
                            wavesurfer.playPause();
                        });
                        
                        wavesurfer.on('play', () => {
                            playBtn.setAttribute('aria-label', 'Mettre en pause');
                            playIcon.classList.add('hidden');
                            pauseIcon.classList.remove('hidden');
                        });
                        
                        wavesurfer.on('pause', () => {
                            playBtn.setAttribute('aria-label', 'Lire l’épisode');
                            playIcon.classList.remove('hidden');
                            pauseIcon.classList.add('hidden');
                        });
                        
                        wavesurfer.on('audioprocess', () => {
                            const currentTime = wavesurfer.getCurrentTime();
                            const duration = wavesurfer.getDuration();
                            timeDisplay.textContent = formatTime(currentTime) + ' / ' + formatTime(duration);
                        });
                        
                        wavesurfer.on('ready', () => {
                            console.log('✅ Waveform ready');
                            const duration = wavesurfer.getDuration();
                            timeDisplay.textContent = '0:00 / ' + formatTime(duration);
                            
                            // Fade out loader et fade in waveform
                            const loader = document.getElementById('waveform-loader-' + episodeId);
                            const waveformEl = document.getElementById('waveform-' + episodeId);
                            
                            if (loader) {
                                loader.style.opacity = '0';
                                loader.style.transition = 'opacity 0.3s';
                                setTimeout(() => loader.style.display = 'none', 300);
                            }
                            
                            if (waveformEl) {
                                waveformEl.style.opacity = '1';
                            }
                        });
                        
                        wavesurfer.on('error', (error) => {
                            console.error('❌ Waveform error:', error);
                        });
                        
                        function formatTime(seconds) {
                            if (isNaN(seconds) || !isFinite(seconds)) return '0:00';
                            const mins = Math.floor(seconds / 60);
                            const secs = Math.floor(seconds % 60);
                            return mins + ':' + (secs < 10 ? '0' : '') + secs;
                        }
                    })();
                </script>
                {{/if}}
                
                {{> expandableDescription episodeDescription}}
                <div class="flex gap-4 text-sm text-gray-400">
                    <span>📅 {{episodeData.pubDate}}</span>
                    <span>⏱️ {{episodeData.duration}}</span>
