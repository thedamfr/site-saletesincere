<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    {{#if episodeData}}
    <title>S{{episodeData.season}}E{{episodeData.episode}} - {{episodeData.title}} | Charbon & Wafer</title>
    <meta name="description" content="{{episodeData.description}}">
    <meta name="author" content="Damien Cavaillès">
    
    {{!-- US4.1: Canonical URL (nouveau format) --}}
    <link rel="canonical" href="https://saletesincere.fr/podcast/{{episodeData.season}}/{{episodeData.episode}}">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article">
    <meta property="og:url" content="https://saletesincere.fr/podcast/{{episodeData.season}}/{{episodeData.episode}}">
    <meta property="og:title" content="S{{episodeData.season}}E{{episodeData.episode}} - {{episodeData.title}} | Charbon & Wafer">
    <meta property="og:description" content="{{episodeData.description}}">
    {{!-- A resolved YouTube maxres thumbnail takes precedence for video episodes. --}}
    {{#if platformLinks.youtube_thumbnail_url}}
    <meta property="og:image" content="{{platformLinks.youtube_thumbnail_url}}">
    <meta property="og:image:width" content="1280">
    <meta property="og:image:height" content="720">
    {{else if platformLinks.og_image_url}}
    <meta property="og:image" content="https://saletesincere.fr/cdn-cgi/image/width=1200,height=630,fit=cover,quality=85,format=png/{{platformLinks.og_image_url}}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    {{else if episodeData.image}}
    <meta property="og:image" content="{{episodeData.image}}">
    {{else}}
    <meta property="og:image" content="https://saletesincere.fr/images/preview-podcast-smartlink.jpg">
    {{/if}}
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@SaleteSincere">
    <meta name="twitter:creator" content="@thedamfr">
    <meta name="twitter:title" content="S{{episodeData.season}}E{{episodeData.episode}} - {{episodeData.title}} | Charbon & Wafer">
    <meta name="twitter:description" content="{{episodeData.description}}">
    {{!-- Twitter Card follows the same episode image precedence. --}}
    {{#if platformLinks.youtube_thumbnail_url}}
    <meta name="twitter:image" content="{{platformLinks.youtube_thumbnail_url}}">
    {{else if platformLinks.og_image_url}}
    <meta name="twitter:image" content="https://saletesincere.fr/cdn-cgi/image/width=1200,height=630,fit=cover,quality=85,format=png/{{platformLinks.og_image_url}}">
    {{else if episodeData.image}}
    <meta name="twitter:image" content="{{episodeData.image}}">
    {{else}}
    <meta name="twitter:image" content="https://saletesincere.fr/images/preview-podcast-smartlink.jpg">
    {{/if}}
    {{else}}
    <title>Charbon & Wafer - Podcast</title>
    <meta name="description" content="Pas de Charbon, Pas de Wafer - Confidences brutes des travailleur·ses du numérique. Disponible sur toutes les plateformes.">
    <meta name="author" content="Damien Cavaillès">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://saletesincere.fr/podcast">
    <meta property="og:site" content="saletesincere.fr">
    <meta property="og:creator" content="@thedamfr">
    <meta property="og:title" content="Charbon & Wafer - Le Podcast est sorti !">
    <meta property="og:description" content="Pas de Charbon, Pas de Wafer - Confidences brutes des travailleur·ses du numérique. Disponible sur toutes les plateformes.">
    {{#if podcastSocialImage}}
    {{#if podcastSocialImage.width}}
    <meta property="og:image" content="https://saletesincere.fr/cdn-cgi/image/width=1200,height=630,fit=cover,quality=85,format=png/{{podcastSocialImage.url}}">
    {{else}}
    <meta property="og:image" content="{{podcastSocialImage.url}}">
    {{/if}}
    <meta property="og:image:alt" content="{{podcastSocialImage.alt}}">
    {{#if podcastSocialImage.width}}
    <meta property="og:image:width" content="{{podcastSocialImage.width}}">
    <meta property="og:image:height" content="{{podcastSocialImage.height}}">
    {{/if}}
    {{else}}
    <meta property="og:image" content="https://saletesincere.fr/images/preview-podcast-smartlink.jpg">
    <meta property="og:image:alt" content="Charbon & Wafer, le podcast de Saleté Sincère">
    {{/if}}
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="https://saletesincere.fr/podcast">
    <meta name="twitter:title" content="Charbon & Wafer - Le Podcast est sorti !">
    <meta name="twitter:description" content="Pas de Charbon, Pas de Wafer - Confidences brutes des travailleur·ses du numérique. Disponible sur toutes les plateformes.">
    {{#if podcastSocialImage}}
    {{#if podcastSocialImage.width}}
    <meta name="twitter:image" content="https://saletesincere.fr/cdn-cgi/image/width=1200,height=630,fit=cover,quality=85,format=png/{{podcastSocialImage.url}}">
    {{else}}
    <meta name="twitter:image" content="{{podcastSocialImage.url}}">
    {{/if}}
    <meta name="twitter:image:alt" content="{{podcastSocialImage.alt}}">
    {{else}}
    <meta name="twitter:image" content="https://saletesincere.fr/images/preview-podcast-smartlink.jpg">
    <meta name="twitter:image:alt" content="Charbon & Wafer, le podcast de Saleté Sincère">
    {{/if}}
    {{/if}}
    
    <link rel="stylesheet" href="/style.css">
</head>
<body class="min-h-screen bg-gradient-to-b from-gray-900 to-black">
    <main class="py-12 px-4">
        <div class="max-w-md mx-auto">
            
            <!-- En-tête avec logo/image -->
            <div class="text-center mb-8 text-white">
                <div class="w-32 h-32 mx-auto mb-4 rounded-full overflow-hidden border-4 border-gray-700 shadow-xl">
                    <img src="/images/charbon-wafer-kintsugi.webp" alt="Charbon & Wafer Podcast" class="w-full h-full object-cover">
                </div>
                <h1 class="text-3xl font-bold mb-2">Charbon & Wafer</h1>
                {{#unless episodeData}}
                {{#unless popularEpisode}}
                <p class="text-xl font-semibold text-yellow-400 mb-1">🎉 Le Podcast est sorti !</p>
                <p class="text-gray-400 text-sm">Choisis ton format et ta plateforme</p>
                {{/unless}}
                {{/unless}}
            </div>

            {{#if popularEpisode}}
            <article class="mb-8 overflow-hidden rounded-2xl border border-purple-600/30 bg-gradient-to-r from-purple-900/20 to-indigo-900/20">
                {{#if popularEpisode.episode.image}}
                <img src="/cdn-cgi/image/width=662,height=662,fit=pad,background=%23000000,quality=85,format=auto/{{popularEpisode.episode.image}}" alt="Jaquette de l'épisode {{popularEpisode.episode.title}}" width="662" height="662" fetchpriority="high" class="h-auto w-full">
                {{/if}}
                <div class="p-6">
                    <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-yellow-400">{{popularEpisode.label}}</p>
                    <p class="mb-2 text-sm uppercase text-purple-300">Saison {{popularEpisode.episode.season}} • Épisode {{popularEpisode.episode.episode}}</p>
                    <h2 class="mb-3 text-2xl font-bold text-white">{{popularEpisode.episode.title}}</h2>
                    <p class="mb-4 text-gray-300">{{popularEpisode.episode.description}}</p>
                    <div class="mb-5 flex flex-wrap gap-4 text-sm text-gray-400">
                        <span>⏱️ {{popularEpisode.episode.duration}}</span>
                        <span>{{popularEpisode.displayText}}</span>
                    </div>
                    <a href="/podcast/{{popularEpisode.episode.season}}/{{popularEpisode.episode.episode}}" class="inline-flex min-h-11 items-center rounded-xl bg-purple-600 px-5 py-3 font-semibold text-white transition-colors hover:bg-purple-500 focus:outline-none focus:ring-2 focus:ring-purple-300 focus:ring-offset-2 focus:ring-offset-gray-900">
                        Découvrir cet épisode
                    </a>
                </div>
            </article>
            {{/if}}
            
            {{#if episodeData}}
            <!-- Episode Highlight -->
            <div class="mb-8 bg-gradient-to-r from-purple-900/20 to-indigo-900/20 rounded-2xl p-6 border border-purple-600/30">
                <div class="text-purple-400 text-sm uppercase mb-2">
                    Saison {{episodeData.season}} • Épisode {{episodeData.episode}}
                </div>
                <h2 class="text-2xl font-bold text-white mb-4">{{episodeData.title}}</h2>

                
                {{!-- OP3 Stats Badge (ADR-0015) --}}
                {{#if episodeStats}}
                {{#if episodeStats.displayText}}
                <details class="mb-4 text-sm text-purple-300">
                    <summary class="flex list-none cursor-pointer items-center gap-2 rounded focus:outline-none focus:ring-2 focus:ring-purple-300 [&::-webkit-details-marker]:hidden" aria-label="Comprendre la mesure OP3">
                        <svg class="h-4 w-4 shrink-0 text-purple-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                            <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
                            <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
                        </svg>
                        <span class="font-medium">{{episodeStats.displayText}}</span>
                        <svg class="h-4 w-4 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                        </svg>
                    </summary>
                    <p class="mt-3 rounded-lg border border-purple-600/30 bg-gray-800 p-3 text-xs text-gray-200">
                        OP3 mesure les téléchargements du fichier audio. Un téléchargement peut être automatique et ne garantit pas une écoute complète. Données mises à jour quotidiennement.
                    </p>
                </details>
                {{/if}}
                {{/if}}
                
                {{#if episodeData.audioUrl}}
                <!-- Waveform Audio Player -->
                <div class="mb-4 bg-black/30 rounded-xl p-4 backdrop-blur-sm">
                    <div class="flex items-center justify-between mb-3">
                        <div class="text-purple-300 text-xs font-medium">🎧 Pré-écoute de l'épisode</div>
                        <div class="text-purple-300 text-xs" id="time-{{episodeData.season}}-{{episodeData.episode}}">0:00 / {{episodeData.duration}}</div>
                    </div>
                    
                    <!-- Waveform container avec placeholder -->
                    <div class="relative mb-3 h-16">
                        <div id="waveform-{{episodeData.season}}-{{episodeData.episode}}" class="absolute inset-0 opacity-0 transition-opacity duration-500"></div>
                        <div id="waveform-loader-{{episodeData.season}}-{{episodeData.episode}}" 
                             class="absolute inset-0 flex items-center justify-center bg-gradient-to-r from-purple-900/20 to-indigo-900/20 rounded-lg">
                            <div class="flex gap-1.5 items-end">
                                <div class="w-1 h-8 bg-purple-500/50 rounded-full animate-pulse" style="animation-delay: 0ms; animation-duration: 1s"></div>
                                <div class="w-1 h-12 bg-purple-400/50 rounded-full animate-pulse" style="animation-delay: 150ms; animation-duration: 1.2s"></div>
                                <div class="w-1 h-6 bg-purple-500/50 rounded-full animate-pulse" style="animation-delay: 300ms; animation-duration: 0.9s"></div>
                                <div class="w-1 h-10 bg-indigo-500/50 rounded-full animate-pulse" style="animation-delay: 450ms; animation-duration: 1.1s"></div>
                                <div class="w-1 h-7 bg-purple-400/50 rounded-full animate-pulse" style="animation-delay: 600ms; animation-duration: 1s"></div>
                                <div class="w-1 h-9 bg-indigo-400/50 rounded-full animate-pulse" style="animation-delay: 750ms; animation-duration: 1.3s"></div>
                                <div class="w-1 h-5 bg-purple-500/50 rounded-full animate-pulse" style="animation-delay: 900ms; animation-duration: 0.8s"></div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Play/Pause button -->
                    <div class="flex items-center justify-center">
                        <button id="playBtn-{{episodeData.season}}-{{episodeData.episode}}" 
                                class="w-12 h-12 rounded-full bg-gradient-to-br from-purple-500 to-indigo-600 hover:from-purple-600 hover:to-indigo-700 flex items-center justify-center transition-all shadow-lg hover:shadow-xl hover:scale-105">
                            <svg id="playIcon-{{episodeData.season}}-{{episodeData.episode}}" class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M8 5v14l11-7z"/>
                            </svg>
                            <svg id="pauseIcon-{{episodeData.season}}-{{episodeData.episode}}" class="w-5 h-5 text-white hidden" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/>
                            </svg>
                        </button>
                    </div>
                </div>
                
                <script type="module">
                    import WaveSurfer from 'https://cdn.jsdelivr.net/npm/wavesurfer.js@7/dist/wavesurfer.esm.js';
                    
                    (function() {
                        const episodeId = '{{episodeData.season}}-{{episodeData.episode}}';
                        const originalUrl = '{{{episodeData.audioUrl}}}'; // Triple braces pour éviter HTML encoding
                        const proxyUrl = `/api/audio/proxy?url=${encodeURIComponent(originalUrl)}`;
                        
                        console.log('🎵 Loading audio via proxy:', proxyUrl);
                        
                        const wavesurfer = WaveSurfer.create({
                            container: '#waveform-' + episodeId,
                            url: proxyUrl,
                            waveColor: '#F1F1F199',                    // Gris foncé (non joué)
                            progressColor: '#a855f7',                  // Purple solid (partie jouée)
                            cursorColor: '#c084fc',                    // Purple-400 pour le curseur
                            barWidth: 3,
                            barGap: 2,
                            height: 60,
                            normalize: true,
                            backend: 'WebAudio',
                            barRadius: 3,                              // Barres arrondies
                            dragToSeek: true                           // Click to seek
                        });
                        
                        const playBtn = document.getElementById('playBtn-' + episodeId);
                        const playIcon = document.getElementById('playIcon-' + episodeId);
                        const pauseIcon = document.getElementById('pauseIcon-' + episodeId);
                        const timeDisplay = document.getElementById('time-' + episodeId);
                        
                        // Play/Pause
                        playBtn.addEventListener('click', () => {
                            wavesurfer.playPause();
                        });
                        
                        wavesurfer.on('play', () => {
                            playIcon.classList.add('hidden');
                            pauseIcon.classList.remove('hidden');
                        });
                        
                        wavesurfer.on('pause', () => {
                            playIcon.classList.remove('hidden');
                            pauseIcon.classList.add('hidden');
                        });
                        
                        wavesurfer.on('audioprocess', () => {
                            const currentTime = wavesurfer.getCurrentTime();
                            const duration = wavesurfer.getDuration();
                            timeDisplay.textContent = formatTime(currentTime) + ' / ' + formatTime(duration);
                        });
                        
                        wavesurfer.on('ready', () => {
                            console.log('✅ Waveform ready');
                            const duration = wavesurfer.getDuration();
                            timeDisplay.textContent = '0:00 / ' + formatTime(duration);
                            
                            // Fade out loader et fade in waveform
                            const loader = document.getElementById('waveform-loader-' + episodeId);
                            const waveformEl = document.getElementById('waveform-' + episodeId);
                            
                            if (loader) {
                                loader.style.opacity = '0';
                                loader.style.transition = 'opacity 0.3s';
                                setTimeout(() => loader.style.display = 'none', 300);
                            }
                            
                            if (waveformEl) {
                                waveformEl.style.opacity = '1';
                            }
                        });
                        
                        wavesurfer.on('error', (error) => {
                            console.error('❌ Waveform error:', error);
                        });
                        
                        function formatTime(seconds) {
                            if (isNaN(seconds) || !isFinite(seconds)) return '0:00';
                            const mins = Math.floor(seconds / 60);
                            const secs = Math.floor(seconds % 60);
                            return mins + ':' + (secs < 10 ? '0' : '') + secs;
                        }
                    })();
                </script>
                {{/if}}
                
                {{#if episodeData.isTruncated}}
                <a href="{{episodeData.episodeLink}}" target="_blank" rel="noopener noreferrer" class="block text-gray-300 hover:text-white transition-colors mb-4">
                    {{episodeData.description}}
                </a>
                {{else}}
                <p class="text-gray-300 mb-4">{{episodeData.description}}</p>
                {{/if}}
                <div class="flex gap-4 text-sm text-gray-400">
                    <span>📅 {{episodeData.pubDate}}</span>
                    <span>⏱️ {{episodeData.duration}}</span>
                </div>
                {{#if episodeVideoAvailability}}
