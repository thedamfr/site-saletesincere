          </div>
        </div>
        <figure>
          <img class="photo-hero-photo" src="/images/photography/dotjs-salon-1600.webp" srcset="/images/photography/dotjs-salon-480.webp 480w, /images/photography/dotjs-salon-960.webp 960w, /images/photography/dotjs-salon-1600.webp 1600w" sizes="(min-width: 1200px) 1080px, 90vw" width="1600" height="1067" fetchpriority="high" decoding="async" alt="Vue d’ensemble du salon dotJS, entre dorures, lustres et échanges entre participants">
