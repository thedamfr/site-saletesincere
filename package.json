{
  "name": "salete-sincere-api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch . --ext js,pug,css server.js",
    "dev:css": "postcss ./style.css -o ./public/style.css --watch",
    "build": "npm run build:css && npm run build:views",
    "build:css": "postcss ./style.css -o ./public/style.css",
    "build:views": "echo 'No-op for Pug views'",
    "check:logo-animation": "node scripts/check-logo-animation.mjs",
    "start": "node server.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --expose-gc --test --test-concurrency=1 test/**/*.test.js",
    "test:watch": "node --test --test-concurrency=1 --watch test/**/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.844.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@fastify/view": "^11.1.0",
    "@tailwindcss/postcss": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.1.0",
    "fast-xml-parser": "^5.3.0",
    "fastify": "^5.4.0",
    "handlebars": "^4.7.8",
    "jimp": "^1.6.0",
    "pg": "^8.16.3",
    "pg-boss": "^11.1.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "playwright": "^1.62.1"
  }
}
